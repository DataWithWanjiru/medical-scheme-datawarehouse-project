# ==============================================================================

print("\nCleaning and standardizing text columns...")


text_columns = [
    "staff_no",
    "main_member",
    "full_name",
    "smart_membership",
    "family_size",
    "sex",
    "relationship",
    "id_number",
    "phone_no",
    "email",
    "category",
    "organization_name",
    "division"
]


# Remove unnecessary spaces and standardize blank values.

for column in text_columns:

    membership_data[column] = (
        membership_data[column]

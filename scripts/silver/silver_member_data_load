# ==============================================================================

print("\nImporting membership data from Bronze Layer...")


bronze_query = text(f'''
    SELECT *
    FROM "{source_schema}"."{source_table}"
''')


with engine.connect() as connection:

    membership_data = pd.read_sql(
        bronze_query,
        connection
    )


# Confirm that the expected Bronze columns exist.

